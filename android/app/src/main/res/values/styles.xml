<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="colorPrimary">@color/noctune_background</item>
    <item name="colorPrimaryDark">@color/noctune_background</item>
    <item name="colorAccent">@color/noctune_accent</item>
    <item name="android:statusBarColor">@color/noctune_background</item>
    <item name="android:navigationBarColor">@color/noctune_background</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>
  <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/noctune_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_noctune_foreground</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
  </style>
</resources>
