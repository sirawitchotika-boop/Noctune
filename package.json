{
  "name": "noctune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent offline-first Android music player",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node scripts/check-shell.mjs",
    "sync": "cap sync android",
    "build:android": "npm run check && npm run sync && cd android && gradle assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
